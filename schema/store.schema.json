{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grimoire-notes/package-store-contents/schema/store.schema.json",
  "title": "Grimoire Package Store catalog",
  "type": "object",
  "required": ["version", "name", "packages"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "tagline": { "type": "string", "maxLength": 240 },
    "updated": { "type": "string", "maxLength": 32 },
    "featured": { "type": "string", "maxLength": 128 },
    "packages": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "relativeOrHttps": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^((https://)|([A-Za-z0-9._~!$&'()*+,;=:@%/-]+))"
    },
    "package": {
      "type": "object",
      "required": ["id", "name", "version", "type", "author", "summary", "description", "license", "repository", "manifest", "icon", "screenshots"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "minLength": 5, "maxLength": 64 },
        "type": { "enum": ["app", "widget"] },
        "author": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "maxLength": 80 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
        "description": { "type": "string", "minLength": 1, "maxLength": 6000 },
        "license": { "type": "string", "maxLength": 120 },
        "repository": { "type": "string", "format": "uri", "maxLength": 512 },
        "homepage": { "type": "string", "format": "uri", "maxLength": 512 },
        "manifest": { "$ref": "#/$defs/relativeOrHttps" },
        "icon": { "$ref": "#/$defs/relativeOrHttps" },
        "screenshots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/relativeOrHttps" }
        },
        "tags": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 32 }
        },
        "added": { "type": "string", "maxLength": 32 }
      }
    }
  }
}
